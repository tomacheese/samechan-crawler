{
  "name": "samechan-crawler",
  "version": "1.0.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "index.js",
  "packageManager": "pnpm@11.26.0+sha512.fc0e2bf890b9f983611f1ab68c0637bce914390653699f83c1a78b005ed25f2c81e77920c8fd8eee2ecf0b58b28cdcb00a84d97f69bcf7c56b2f344710238664",
  "scripts": {
    "start": "tsx ./src/main.ts",
    "dev": "tsx --watch ./src/main.ts",
    "package": "run-z clean compile packing",
    "packing": "ncc build ./dist/main.js -o output/",
    "compile": "tsc -p .",
    "clean": "rimraf dist output",
    "lint": "run-z lint:prettier,lint:eslint,lint:tsc",
    "lint:prettier": "prettier --check src",
    "lint:eslint": "eslint . -c eslint.config.mjs",
    "lint:tsc": "tsc",
    "fix": "run-z fix:prettier fix:eslint",
    "fix:eslint": "eslint . -c eslint.config.mjs --fix",
    "fix:prettier": "prettier --write src",
    "preinstall": "npx only-allow pnpm"
  },
  "dependencies": {
    "@book000/node-utils": "1.25.94",
    "@the-convocation/twitter-scraper": "0.22.3",
    "cycletls": "2.0.5",
    "headers-polyfill": "5.0.1",
    "twitter-openapi-typescript": "0.0.56"
  },
  "devDependencies": {
    "@book000/eslint-config": "1.16.60",
    "@types/node": "24.13.3",
    "@types/tough-cookie": "4.0.5",
    "@vercel/ncc": "0.45.0",
    "eslint": "10.10.0",
    "eslint-config-standard": "17.1.0",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-n": "18.3.0",
    "eslint-plugin-promise": "7.3.0",
    "prettier": "3.9.6",
    "rimraf": "6.1.3",
    "run-z": "2.1.0",
    "tsx": "4.23.13",
    "typescript": "6.0.3"
  }
}
