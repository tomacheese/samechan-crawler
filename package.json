{
  "name": "samechan-crawler",
  "version": "1.0.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "index.js",
  "packageManager": "pnpm@12.16.0+sha512.e9ccc91a0b8d52da297c16841f9ee05f3ddd631bd757ef26a211687d4a38de653c614453649294438c58be74c2ba62d53e633a4e153708c012296d0f3ee27b36",
  "scripts": {
    "start": "tsx ./src/main.ts",
    "dev": "tsx --watch ./src/main.ts",
    "package": "run-z clean compile packing",
    "packing": "ncc build ./dist/main.js -o output/",
    "compile": "tsc -p .",
    "clean": "rimraf dist output",
    "lint": "run-z lint:prettier,lint:eslint,lint:tsc",
    "lint:prettier": "prettier --check src",
    "lint:eslint": "eslint . -c eslint.config.mjs",
    "lint:tsc": "tsc",
    "fix": "run-z fix:prettier fix:eslint",
    "fix:eslint": "eslint . -c eslint.config.mjs --fix",
    "fix:prettier": "prettier --write src",
    "preinstall": "npx only-allow pnpm"
  },
  "dependencies": {
    "@book000/node-utils": "1.25.183",
    "@the-convocation/twitter-scraper": "0.22.3",
    "cycletls": "2.0.5",
    "headers-polyfill": "5.0.1",
    "twitter-openapi-typescript": "0.1.3"
  },
  "devDependencies": {
    "@book000/eslint-config": "1.16.109",
    "@types/node": "24.19.2",
    "@types/tough-cookie": "4.0.5",
    "@vercel/ncc": "0.45.0",
    "eslint": "10.13.0",
    "eslint-config-standard": "17.1.0",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-n": "18.5.0",
    "eslint-plugin-promise": "7.3.0",
    "prettier": "3.9.10",
    "rimraf": "6.1.3",
    "run-z": "2.1.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3"
  }
}
