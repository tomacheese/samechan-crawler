{
  "name": "samechan-crawler",
  "version": "1.0.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "index.js",
  "packageManager": "pnpm@11.24.0+sha512.bd27e345e976dcb0be0b7a1228217b049a817e21b1f355c90dbe7dc46671895a8bc1e6d06c24554505ea93ea0b45f489a27ec1bfbc8de6a9659fca0f16fa0000",
  "scripts": {
    "start": "tsx ./src/main.ts",
    "dev": "tsx --watch ./src/main.ts",
    "package": "run-z clean compile packing",
    "packing": "ncc build ./dist/main.js -o output/",
    "compile": "tsc -p .",
    "clean": "rimraf dist output",
    "lint": "run-z lint:prettier,lint:eslint,lint:tsc",
    "lint:prettier": "prettier --check src",
    "lint:eslint": "eslint . -c eslint.config.mjs",
    "lint:tsc": "tsc",
    "fix": "run-z fix:prettier fix:eslint",
    "fix:eslint": "eslint . -c eslint.config.mjs --fix",
    "fix:prettier": "prettier --write src",
    "preinstall": "npx only-allow pnpm"
  },
  "dependencies": {
    "@book000/node-utils": "1.25.71",
    "@the-convocation/twitter-scraper": "0.22.3",
    "cycletls": "2.0.5",
    "headers-polyfill": "5.0.1",
    "twitter-openapi-typescript": "0.0.56"
  },
  "devDependencies": {
    "@book000/eslint-config": "1.16.49",
    "@types/node": "24.13.3",
    "@types/tough-cookie": "4.0.5",
    "@vercel/ncc": "0.45.0",
    "eslint": "10.9.1",
    "eslint-config-standard": "17.1.0",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-n": "18.3.0",
    "eslint-plugin-promise": "7.3.0",
    "prettier": "3.9.6",
    "rimraf": "6.1.3",
    "run-z": "2.1.0",
    "tsx": "4.23.12",
    "typescript": "6.0.3"
  }
}
